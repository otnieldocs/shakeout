{
  "name": "shakeout",
  "version": "0.0.1",
  "description": "Put the real thing through real conditions. Agent-driven QA against a live staging environment — real browser, real data, real integrations. No mocks.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": { "shakeout": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/contracts.test.ts",
    "shakeout": "tsx src/cli.ts"
  },
  "keywords": ["qa", "testing", "e2e", "staging", "playwright", "agent", "no-mocks"],
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
