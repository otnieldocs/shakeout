{
  "name": "shakeout",
  "version": "0.0.1",
  "description": "Put the real thing through real conditions. Agent-driven QA against a live staging environment — real browser, real data, real integrations. No mocks.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Otniel <otniel@kreasistudio.co.id>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnieldocs/shakeout.git"
  },
  "bugs": {
    "url": "https://github.com/otnieldocs/shakeout/issues"
  },
  "homepage": "https://github.com/otnieldocs/shakeout#readme",
  "bin": {
    "shakeout": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/contracts.test.ts",
    "shakeout": "tsx src/cli.ts"
  },
  "keywords": [
    "qa",
    "testing",
    "e2e",
    "staging",
    "playwright",
    "agent",
    "no-mocks"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@inquirer/prompts": "8.7.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
